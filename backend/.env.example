# Copy this file to .env and fill in real values before running

# MySQL
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpass
DB_NAME=inventory

# Kafka
KAFKA_BROKER=kafka:9092
KAFKA_TOPIC=low-stock-alerts

# OpenAI (used by the LangChain agent)
OPENAI_API_KEY=sk-your-key-here

# Server
PORT=4000
